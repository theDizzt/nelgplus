# Copy this file to .env.newgrounds and fill in the values from the
# Newgrounds Project > API Tools page. Vite loads this file when the
# build-newgrounds.bat script uses --mode newgrounds.
VITE_NEWGROUNDS_ENABLED=true
VITE_NEWGROUNDS_APP_ID=
VITE_NEWGROUNDS_ENCRYPTION_KEY=
VITE_NEWGROUNDS_VERSION=1.1.94
