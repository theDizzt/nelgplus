# Server-only Vercel Function variables. Set the real values in
# Vercel Dashboard > Project > Settings > Environment Variables.
# Never rename either variable with a VITE_ prefix.
DISCORD_WINNER_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
ALLOWED_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,https://thedizzt.github.io

# Public frontend variable used when the game is hosted on GitHub Pages
# and the relay function is hosted in a separate Vercel project.
VITE_WINNER_REPORT_API_URL=https://YOUR_VERCEL_PROJECT.vercel.app/api/winner-report
